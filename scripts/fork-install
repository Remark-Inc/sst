#!/usr/bin/env bash
# Run from an extracted, externally checksum-verified archive. No network access.
set -euo pipefail
cd "$(dirname "$0")"
if [ "$#" -ne 1 ]; then echo 'Usage: ./install /absolute/path/to/versioned-install-directory' >&2; exit 1; fi
case "$1" in /*) ;; *) echo 'Install destination must be absolute' >&2; exit 1;; esac
python3 - "$1" <<'PY'
import json, pathlib, shutil, sys
manifest = json.loads(pathlib.Path('manifest.json').read_text())
if not manifest['distributable']:
    raise SystemExit('Dirty review builds cannot be installed as distributions')
dest = pathlib.Path(sys.argv[1])
# Refuse overwrite: switching versions must be an explicit caller decision.
dest.mkdir(parents=True, exist_ok=False)
for src in pathlib.Path('.').iterdir():
    if src.is_file():
        shutil.copy2(src, dest / src.name)
    elif src.name == 'third-party-notices':
        shutil.copytree(src, dest / src.name)
(dest / 'sst-forum').write_text('#!/usr/bin/env bash\nset -euo pipefail\nexport SST_SKIP_LOCAL=true\nexec "$(dirname "$0")/sst" "$@"\n')
(dest / 'sst-forum').chmod(0o755)
print(f'Invoke {dest}/sst-forum directly; version {manifest["version"]}')
PY
